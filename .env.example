# ─────────────────────────────────────────────────────────────────
# WWW STUDIO — Environment Configuration
# ─────────────────────────────────────────────────────────────────

# ── AI Provider Configuration ──────────────────────────────────────
# Default: OmniRoute local gateway (port 20128, OpenAI-compatible)
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=omniroute
LLM_MODEL=auto/best-coding-fast

# Vision model for screenshot-to-code (defaults to LLM_MODEL)
LLM_VISION_MODEL=auto/best-coding-fast

# ── OpenRouter Fallback (optional) ────────────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://www-studio.vercel.app

# ── Production (Cloudflare Tunnel) ───────────────────────────────
# OmniRoute (local):    LLM_BASE_URL=http://127.0.0.1:20128/v1
# Tailnet (remote):     LLM_BASE_URL=http://100.125.198.47:20128/v1
# Note: OmniRoute is only reachable locally; not from Vercel production.

# ── Gemini Web2API Specific ──────────────────────────────────────
# If running gemini-web2api on a different port/host:
# GEMINI_WEB2API_BASE_URL=http://localhost:8081/v1
# GEMINI_WEB2API_MODEL=gemini-3.5-flash
# GEMINI_WEB2API_API_KEY=sk-gemini

# ── Vercel Deployment ────────────────────────────────────────────
# Set these in Vercel dashboard:
#   LLM_BASE_URL       → https://<your-tunnel>.trycloudflare.com/v1
#   OPENROUTER_API_KEY → sk-or-... (optional fallback)